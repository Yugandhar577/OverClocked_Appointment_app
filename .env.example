DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/appointments
JWT_SECRET=replace-with-a-32-character-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=28800
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@appointments.local
APP_BASE_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
FUTURE_DAYS_LIMIT_DEFAULT=30
OTP_TTL_SECONDS=600
RESET_TOKEN_TTL_SECONDS=900
# Google OAuth — get your client ID from https://console.cloud.google.com/
# Leave empty to disable the "Sign in with Google" button
GOOGLE_CLIENT_ID=
# Frontend: use /api/v1 with Vite proxy (default in src/api/client.ts). For docker-compose frontend, proxy targets the backend service.
# Only set a full URL if you serve a production build without a dev proxy:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=OverClocked Appointments
VITE_GOOGLE_CLIENT_ID=
# Set to "true" to use synthetic mock data for all admin pages (no backend required)
VITE_ADMIN_MOCK_DATA=false
ENABLE_WAITLIST=false
ENABLE_BOOKING_CART=false
ENABLE_VARIABLE_DURATION=false
ENABLE_RECURRING_BOOKINGS=false
ENABLE_NO_SHOW_PROTECTION=false
ENABLE_SMART_ASSIGNMENT=false
ENABLE_DYNAMIC_PRICING=false
ENABLE_NOTIFICATION_WORKFLOWS=false
ENABLE_ADMIN_MANUAL_BOOKING=false
ENABLE_APPOINTMENT_ANALYTICS=false
ENABLE_THEME_CUSTOMIZATION=false
ENABLE_ODOO_STYLE_UI=false
# Razorpay (https://dashboard.razorpay.com/) — add these to your real `.env` (not committed).
# Leave unset in `dev` to use an automatic local demo checkout (no external gateway).
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# Force mock checkout even when keys exist (testing only). In production set ENV below and use real keys.
# MOCK_PAYMENTS=false
# Hackathon / presentation only: allows POST /payments/demo-complete without Razorpay. Never enable in production.
# DEMO_PAYMENT_BYPASS=false
# Production: use a non-dev value so mock checkout is never auto-enabled, e.g. ENV=production
# ENV=dev
