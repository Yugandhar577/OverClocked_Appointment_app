APP_NAME=OverClocked Appointment App
ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/appointments
JWT_SECRET=change-me-to-a-32-character-minimum-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=28800
APP_BASE_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
OTP_TTL_SECONDS=600
RESET_TOKEN_TTL_SECONDS=900

# Replace re_xxxxxxxxx with your real Resend API key in .env.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
